# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# URL du front (React/Vite) qui héberge le formulaire de complétion de profil
FRONTEND_URL=http://localhost:5173
# Origines autorisées pour CORS (optionnel, liste séparée par des virgules)
CORS_ORIGINS=http://localhost:5173
# Durée de validité d'une invitation de profil
PROFILE_INVITATION_EXPIRATION_HOURS=72

# ------------------------------------------------------------------
# Base de données (PostgreSQL)
# Renseigner DATABASE_URL, ou bien les 5 variables ci-dessous
# DATABASE_URL=postgresql://user:password@localhost:5432/parrainage
# ------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# Recréer automatiquement le schéma au démarrage (déconseillé en production)
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# ------------------------------------------------------------------
# Envoi des emails
# Sur Render (ports SMTP bloqués), renseigner BREVO_API_KEY : l'envoi passe alors
# par l'API HTTP de Brevo et les variables SMTP_HOST/PORT/USER/PASS sont ignorées.
# SMTP_FROM_EMAIL doit être une adresse validée comme expéditeur dans Brevo.
# BREVO_API_KEY=
# SMTP (notifications par email)
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Programme de parrainage
SMTP_FROM_EMAIL=
# URL de base de l'API
APP_BASE_URL=http://localhost:3000
